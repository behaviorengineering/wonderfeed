# Copy to deploy/ytzero/.env and edit. Never commit .env.
# First `wonderfeed provider up` / `make serve` creates .env from this file
# and replaces POSTGRES_PASSWORD when it is still the placeholder.

# Required: PostgreSQL password (no special URL characters like @ : / ? #).
POSTGRES_PASSWORD=change-me-now

# Optional DB identity (must match DATABASE_URL user/db in compose).
# POSTGRES_USER=ytzero
# POSTGRES_DB=ytzero
# POSTGRES_IMAGE=postgres:17-alpine

# App image. Prefer the host src-patch image until upstream ships the Postgres
# cold-start fixes (see docs/operator-ytzero.md). Build with: make provider-image
YTZERO_IMAGE=wonderfeed-ytzero:src-patch
# Upstream release (no local patch): ghcr.io/pelski/ytzero:2026.09.8

# Host port published to localhost (container stays on 3001).
# YTZERO_HOST_PORT=3001

# PostgreSQL published to host loopback for wonderfeed control serve.
# POSTGRES_HOST_PORT=127.0.0.1:5432

# Control plane (wonderfeed control serve).
# DATABASE_URL=postgres://ytzero:${POSTGRES_PASSWORD}@127.0.0.1:5432/ytzero?sslmode=disable
# WONDERFEED_CONTROL_BIND=127.0.0.1:8080
# WONDERFEED_PARENT_AUTH_KEY=
# YTZERO_BASE_URL=http://127.0.0.1:3001
# Optional household admin session for policy HTTP patches (ytzero_session=...).
# Allowlist sync uses DATABASE_URL direct writes to YT Zero tables, not this cookie.
# YTZERO_SESSION_COOKIE=

# Optional IANA timezone (locks the in-app timezone picker when set).
# TZ=Australia/Sydney

# Force shared-password auth from the environment (password never written to DB).
# YTZERO_AUTH_METHOD=shared
# YTZERO_AUTH_PASSWORD=${YTZERO_AUTH_PASSWORD}

# Public base URL when behind a reverse proxy or Cloudflare Tunnel.
# APP_URL=https://42.homes.wonderfeed.app

# Feed refresh tuning.
# IDLE_TIMEOUT_SECONDS=120
# REFRESH_INTERVAL_MINUTES=5
# FULL_SYNC_INTERVAL_MINUTES=15
# VIDEO_MAINTENANCE_MAX_AGE_DAYS=90

# --- Encrypted state backups (wonderfeed backup create|list|restore) ---
# Age identity defaults to data/backups/age-identity.txt (created on first backup).
# WONDERFEED_BACKUP_AGE_IDENTITY=/absolute/path/to/age-identity.txt
# WONDERFEED_BACKUP_LOCAL_ONLY=1
# Optional S3-compatible upload (R2 / B2 / MinIO). Leave unset for local-only.
# WONDERFEED_BACKUP_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# WONDERFEED_BACKUP_S3_REGION=auto
# WONDERFEED_BACKUP_S3_BUCKET=wonderfeed-home-backups
# WONDERFEED_BACKUP_S3_ACCESS_KEY=
# WONDERFEED_BACKUP_S3_SECRET_KEY=
# WONDERFEED_BACKUP_S3_PREFIX=wonderfeed/backups
