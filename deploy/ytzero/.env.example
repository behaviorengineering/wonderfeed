# Copy to deploy/ytzero/.env and edit. Never commit .env.
# See providers/ytzero wiki Configuration for the full upstream list.

# Published image. Default matches the submodule release label 2026.09.8.
# YTZERO_IMAGE=ghcr.io/pelski/ytzero:2026.09.8

# Host port published to localhost (container stays on 3001).
# YTZERO_HOST_PORT=3001

# Optional IANA timezone (locks the in-app timezone picker when set).
# TZ=Australia/Sydney

# Force shared-password auth from the environment (password never written to DB).
# YTZERO_AUTH_METHOD=shared
# YTZERO_AUTH_PASSWORD=${YTZERO_AUTH_PASSWORD}

# Public base URL when behind a reverse proxy (OIDC / WebAuthn origin).
# APP_URL=https://ytzero.example.local

# Feed refresh tuning (seconds/minutes as named).
# IDLE_TIMEOUT_SECONDS=120
# REFRESH_INTERVAL_MINUTES=5
# FULL_SYNC_INTERVAL_MINUTES=15
# VIDEO_MAINTENANCE_MAX_AGE_DAYS=90
